{
  "templateName": "Complete Developer Workflow",
  "version": "1.0",
  "author": "DevAssistant AI",
  "description": "Comprehensive template that coordinates all developer activities with scheduling, dependencies, and workflow management",
  "metadata": {
    "created": "2025-11-04",
    "lastUpdated": "2025-11-04",
    "tags": ["programming", "devops", "architecture", "refactoring", "bugfixing", "planning"]
  },
  "workflow": {
    "defaultTemplate": "Advanced Programmer Assistant",
    "templateDependencies": {
      "Advanced Programmer Assistant": [],
      "Bug Fix Assistant": ["Advanced Programmer Assistant"],
      "Refactoring Assistant": ["Advanced Programmer Assistant"],
      "Code Review Assistant": [],
      "DevOps Assistant": [],
      "Architect Assistant": ["Code Review Assistant"]
    },
    "scheduling": {
      "automaticTemplateSelection": true,
      "taskTypeRecognition": {
        "bug": "Bug Fix Assistant",
        "fix": "Bug Fix Assistant",
        "refactor": "Refactoring Assistant",
        "review": "Code Review Assistant",
        "deploy": "DevOps Assistant",
        "architecture": "Architect Assistant",
        "design": "Architect Assistant"
      }
    }
  },
  "contextManagement": {
    "contextChainEnabled": true,
    "crossTemplateContext": true,
    "historyRetention": 50,
    "contextCleanup": {
      "fileChanges": true,
      "timeoutMinutes": 120,
      "onTemplateSwitch": false
    }
  },
  "executionRules": {
    "maxStepsPerSession": 100,
    "stepTimeoutMinutes": 10,
    "retryAttempts": 3,
    "rollbackOnFailure": true
  },
  "integrationPoints": {
    "externalTools": ["git", "docker", "pytest", "make"],
    "fileMonitoring": true,
    "commandTracking": true,
    "resultAggregation": true
  },
  "visualization": {
    "showContextChain": true,
    "expandableDetails": true,
    "statusColors": {
      "active": "#c8ffc8",
      "invalidated": "#ffc8c8",
      "removed": "#c8c8c8"
    },
    "defaultCollapsed": true
  },
  "advancedFeatures": {
    "planner": {
      "enabled": true,
      "type": "stepBased",
      "autoSchedule": true,
      "dependencyTracking": true
    },
    "analyzer": {
      "codeQuality": true,
      "security": true,
      "performance": true
    },
    "assistant": {
      "contextAware": true,
      "learningEnabled": false,
      "suggestionEngine": true
    }
  }
}