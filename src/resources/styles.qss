/* DevAssistantQt Global Stylesheet */

QMainWindow, QDialog, QWidget {
    background: #f2fbf9;
    color: #0f172a;
    font: 10pt "Segoe UI";
}

QLabel {
    color: #0f172a;
}

QListWidget, QTreeWidget, QTreeView, QTableView, QPlainTextEdit, QTextEdit, QTextBrowser, QGraphicsView {
    background: #ffffff;
    border: 1px solid #bfeee6;
    border-radius: 6px;
}

QScrollArea {
    border: none;
    background: transparent;
}

QHeaderView::section {
    background: #e6fffa;
    border: none;
    border-bottom: 1px solid #bfeee6;
    padding: 4px 8px;
    font: 600 9pt "Segoe UI";
}

QTabWidget::pane {
    border: 1px solid #bfeee6;
    border-radius: 6px;
}

QTabBar::tab {
    background: #ccfbf1;
    color: #134e4a;
    border: 1px solid #8ed9cf;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 5px 10px;
    margin-right: 1px;
}

QTabBar::tab:selected {
    background: #ffffff;
    color: #0f766e;
}
